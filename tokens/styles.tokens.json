  "shadow": {
    "elevation": {
      "raised": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{elevation.shadow}",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px",
            "inset": false
          },
          {
            "color": "{elevation.shadow}",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "3px",
            "spread": "0px",
            "inset": false
          }
        ],
        "$description": "Cards that need lift off a same-color surface. Prefer surface color + border first."
      },
      "overlay": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{elevation.shadow}",
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "12px",
            "spread": "0px",
            "inset": false
          },
          {
            "color": "{elevation.shadow}",
            "offsetX": "0px",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "0px",
            "inset": false
          }
        ],
        "$description": "Menus, popovers, tooltips — anything floating above content."
      },
      "modal": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{elevation.shadow-strong}",
            "offsetX": "0px",
            "offsetY": "16px",
            "blur": "48px",
            "spread": "0px",
            "inset": false
          }
        ],
        "$description": "Dialogs and sheets. Pair with surface/scrim."
      }
    }
  }
